{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"id": "parent-e3294ad57e724bd081d95fe0dd925339", "metadata": {"producer": "Hancom PDF 1.3.0.542", "creator": "Hwp 2020 1.0.0.0", "creationdate": "2023-05-10T17:15:49+09:00", "author": "\ubc95\uc81c\ucc98 \uad6d\uac00\ubc95\ub839\uc815\ubcf4\uc13c\ud130", "moddate": "2023-05-10T17:15:49+09:00", "pdfversion": "1.4", "source": "D:\\LEE\\AI_team\\github\\Vision_AI_RnD_team\\projects\\pj10(Agentic_AIS_Simulator_Client)\\src\\my_battlefield_crew\\data\\doctrine_data\\raw_documents\\\uace0\uc18d\ub2e8\uc815_\uc548\uc804\ub9e4\ub274\uc5bc.pdf", "total_pages": 48, "page": 25, "page_label": "26", "doc_id": "parent-e3294ad57e724bd081d95fe0dd925339"}, "page_content": "\uace0\uc18d\ub2e8\uc815 \uc548\uc804\ub9e4\ub274\uc5bc \uac1c\uc815\ubc88\ud638 1\n\uc81c3\uc7a5  \uace0\uc18d\ub2e8\uc815 \uc6b4\uc6a9 \ud398 \uc774 \uc9c0 23\n      \uba70, \uc120\ubbf8\uac00 \uc775\uc218\uc790 \ucabd\uc73c\ub85c \ud750\ub974\uac8c \ud558\uc5ec \uc811\uadfc \ud6c4 \uad6c\uba85\uc904, \ud398\ub2ec \ub4f1\uc744 \uc774\uc6a9\ud558\uc5ec \uad6c\n\uc870\ud55c\ub2e4.\n  \uc0ac. \uc775\uc218\uc790\uac00 \uc758\uc2dd\ubd88\uba85\uc774\ub098 \uac00\ub77c\uc549\ub294 \uacbd\uc6b0 \uad6c\uc870 \uc694\ub839\n     1) \uc775\uc218\uc790\uc758 \ud48d\uc0c1 \ucabd\uc5d0\uc11c \uc800\uc18d\uc73c\ub85c \uc811\uadfc\ud558\uace0, \uc775\uc218\uc790\ub97c \uc7a1\uc744 \uc218 \uc788\ub294 \uac70\ub9ac\uc5d0 \ub3c4\ub2ec\n\ud558\uba74 \uc989\uc2dc \uae30\uc5b4\ub97c \uc911\ub9bd \uc704\uce58\uc5d0 \ub193\uc544\uc57c \ud55c\ub2e4.\n     2) \uc775\uc218\uc790\uc5d0\uac8c \uc811\uadfc \uc2dc \uc5d4\uc9c4\uc758 \uae09\uac00\uc18d\uc740 \uc808\ub300 \uae08\ud558\uba70, \ud48d\ud5a5\uacfc \ud48d\uc18d, \uc870\ub958 \ub4f1 \ub3cc\ubc1c \n\uc0c1\ud669\uc5d0 \ub300\ube44\ud574\uc57c \ud55c\ub2e4.\n     3) \uace0\uc18d\ub2e8\uc815 \uc815\uc7a5\uc740 \uc775\uc218\uc790\uc5d0 \ub300\ud55c \uc2dc\uacc4\ub97c \ucda9\ubd84\ud788 \ud655\ubcf4\ud558\uc5ec\uc57c \ud558\uba70, \uae30\uad00\uc774 \uc775\uc218\n\uc790\uc5d0\uac8c \ucd5c\ub300\ud55c \uba40\ub9ac \uc704\uce58\ud558\uac8c \uc870\uc885\ud558\uc5ec\uc57c \ud55c\ub2e4.\n7. \ud56d\ud574 \uc2dc \uc720\uc758\uc0ac\ud56d\n  \uac00. \uae09\uc120\ud68c \uc2dc\ub294 \uc18d\ub825, \ud48d\ud5a5\uacfc \ud48d\uc18d\uc744 \uace0\ub824\ud558\uc5ec\uc57c \ud558\uba70, \uc775\uc218\uc790 \ubc1c\uc0dd\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\n\ud574 \uc0ac\uc804\uc5d0 \ud0d1\uc2b9\uc694\uc6d0\uc5d0\uac8c \uc54c\ub824 \ubab8\uc744 \uace0\uc815\ud558\uac8c \ud558\uc5ec\uc57c \ud55c\ub2e4.\n  \ub098. \uae34\uae09 \uc0c1\ud669\uc744 \uc81c\uc678\ud558\uace0\ub294 \uae09\uac00\uc18d\uc744 \uae08\ud55c\ub2e4.\n  \ub2e4. \uace0\uc18d \ud56d\ud574 \uc911 \uae09\uc791\uc2a4\ub7fd\uac8c \uae30\uc5b4\ub97c \ud6c4\uc9c4\uc73c\ub85c \uc870\uc791\ud558\uba74, \ubaa8\ud130\uc758 \uc190\uc0c1\uc744 \uc720\ubc1c\ud558\ubbc0\ub85c \n\uc720\uc758\ud558\uc5ec\uc57c \ud55c\ub2e4.\n  \ub77c. \uc2dc\uac01, \uccad\uac01 \ub4f1 \ubaa8\ub4e0 \uc720\ud6a8\uc218\ub2e8\uc744 \ub3d9\uc6d0\ud558\uc5ec \ud56d\uc0c1 \uacac\uc2dc\ub97c \ubc30\uce58\ud574\uc57c \ud558\uba70, \uc57c\uac04 \ud56d\ud574 \n\uc2dc\ub294 \uc57c\uac04 \ud56d\ud574\uc6a9 \uc7a5\ube44\ub97c \ud65c\uc6a9\ud558\uc5ec\uc57c \ud55c\ub2e4.\n  \ub9c8. \ud56d\ud574 \uc2dc\ub294 \uc548\uc804\uc18d\ub825\uc73c\ub85c \uc6b4\ud56d\ud558\uc5ec\uc57c \ud558\uba70, \uc548\uc804 \uc18d\ub825\uc740 \uc2dc\uc815, \ud0c0 \uc120\ubc15\uc758 \uad50\ud1b5\ub7c9, \n\uc815\uc9c0\uac70\ub9ac \ubc0f \uc120\ud68c\ub2a5\ub825, \ud48d\ud5a5, \ud48d\uc18d, \uc870\ub958, \ud56d\ud574 \uc7a5\uc560\ubb3c\uc758 \uadfc\uc811\uc0c1\ud0dc \ub4f1\uc744 \uace0\ub824\ud558\uc5ec \n\uacb0\uc815\ud55c\ub2e4.\n  \ubc14. \ud56d\ud574\uc911\uc778 \uc120\ubc15\uc758 \uc804\ubc29\uc744 \ud6a1\ub2e8\ud558\uc5ec\uc11c\ub294 \uc548 \ub41c\ub2e4.", "type": "Document"}}