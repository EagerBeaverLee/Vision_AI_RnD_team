{"lc": 1, "type": "constructor", "id": ["langchain", "schema", "document", "Document"], "kwargs": {"id": "parent-46587e9e3a1d439b891ba6fbc23be7a0", "metadata": {"producer": "Hancom PDF 1.3.0.542", "creator": "Hwp 2020 1.0.0.0", "creationdate": "2023-05-10T17:15:49+09:00", "author": "\ubc95\uc81c\ucc98 \uad6d\uac00\ubc95\ub839\uc815\ubcf4\uc13c\ud130", "moddate": "2023-05-10T17:15:49+09:00", "pdfversion": "1.4", "source": "D:\\LEE\\AI_team\\github\\Vision_AI_RnD_team\\projects\\pj10(Agentic_AIS_Simulator_Client)\\src\\my_battlefield_crew\\data\\doctrine_data\\raw_documents\\\uace0\uc18d\ub2e8\uc815_\uc548\uc804\ub9e4\ub274\uc5bc.pdf", "total_pages": 48, "page": 21, "page_label": "22", "doc_id": "parent-46587e9e3a1d439b891ba6fbc23be7a0"}, "page_content": "\ub2e4) \uc8fc\uc704\uc758 \uc548\uc804\uc744 \ud655\uc778\ud55c\ub2e4.\n       \ub77c) \uc794\uad50 \ubc18\ub300\ubc29\ud5a5\uc73c\ub85c \ud578\ub4e4\uc744 \ub3cc\ub9ac\uace0 \ub808\ubc84\ub97c \ud6c4\uc9c4\uc73c\ub85c \ubc00\uc5b4 \ub123\uace0 \uc11c\uc11c\ud788 \uc774\uc548\n\ud55c\ub2e4.\n       \ub9c8) \uc120\uc218\uac00 \uc794\uad50\uc640 \ubd80\ub52a\ud790 \uac83 \uac19\uc73c\uba74 \ud578\ub4e4\uc744 \uc794\uad50\uce21\uc73c\ub85c \ub418\ub3cc\ub824\uc11c \uc120\uc218\ub97c \uc794\uad50\n\uc5d0\uc11c \uba40\uc5b4\uc9c0\uac8c \ud55c \ub2e4\uc74c \uc11c\uc11c\ud788 \ubc18\ub300\uce21\uc73c\ub85c \ud578\ub4e4\uc744 \ub3cc\ub824 \uc774\uc548\ud55c\ub2e4\n     4) \ud6c4\uc9c4\n       \uac00) \ud6c4\uc9c4\uc694\ub839\n          (1) \ud6c4\uc9c4 \ucd5c\uc800 \uc18d\ub825\uc73c\ub85c \uae30\ub3d9\ud55c\ub2e4.\n\uace0\uc18d\ub2e8\uc815 \uc548\uc804\ub9e4\ub274\uc5bc \uac1c\uc815\ubc88\ud638 1\n\uc81c3\uc7a5  \uace0\uc18d\ub2e8\uc815 \uc6b4\uc6a9 \ud398 \uc774 \uc9c0 19\n          (2) \ud578\ub4e4\uc740 \uc0c1\ubd80\ub97c \uc7a1\uc544 \uc88c\uc6b0 \uc5b4\ub290 \ucabd\uc73c\ub85c\ub3c4 \ud0c0\ub97c \ub3cc\ub9ac\uae30 \uc27d\ub3c4\ub85d \ud55c\ub2e4.\n          (3) \uc120\ud68c\ud558\uace0\uc790 \ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \ud578\ub4e4\uc744 \ub3cc\ub9b0\ub2e4.\n       \ub098) \ud6c4\uc9c4 \uc911 \uae09\uaca9\ud788 \uc99d\uc18d\ud558\uba74 \uc120\uccb4\ub098 \uae30\uad00\uc758 \uace0\uc7a5, \uc120\ubbf8\uce68\uc218 \ub4f1 \uc120\uc678\ubaa8\ud130\uc5d0 \ubb34\n\ub9ac\ud55c \uc800\ud56d\uacfc \ubd80\ud558\uac00 \uac78\ub9b4 \uc218 \uc788\ub2e4.\n       \ub2e4) \ubc14\ub78c\uc774\ub098 \uc870\ub958\uac00 \uac15\ud560 \uc2dc\uc5d0\ub294 \uc870\uae08\uc529 \uc99d\uc18d\ud560 \ud544\uc694\uac00 \uc788\uc9c0\ub9cc, \ud0c0\ub825\uc774 \uc788\uc744 \n\uc815\ub3c4\uc758 \ucd5c\uc800 \uc18d\ub825\ub9cc \uc0ac\uc6a9\ud55c\ub2e4.\n       \ub77c) \uc548\uc804\ud655\uc778\n          (1) \ud6c4\uc9c4 \uc2dc \uc5bc\uad74\uc744 \uc644\uc804\ud788 \ub4a4\ub85c \ub3cc\ub824\uc11c \ud6c4\ubc29 \ubc0f \uc804\ubc29, \uc88c\uc6b0\ub97c \ubaa8\ub450 \ub3cc\ub824\ubcf4\n\uace0 \uc548\uc804\uc744 \ud655\uc778\ud574\uc57c \ud55c\ub2e4.\n          (2) \ud6c4\ubc29\uc774 \ucda9\ubd84\ud788 \ubcf4\uc774\uc9c0 \uc54a\ub294 \ubd80\ub4dd\uc774\ud55c \uacbd\uc6b0\uc5d0\ub294 \uc88c\uc11d\uc5d0\uc11c \uc77c\uc5b4\ub098 \uc88c\uc11d\uc758 \n\ud6c4\ubd80 \ub610\ub294 \ud604\uce21 \ub4f1\uc5d0 \ubab8\uc744 \ucda9\ubd84\ud788 \uae30\ub300\uc5b4\uc11c \uc548\uc815\ub41c \uc870\uc815 \uc790\uc138\ub97c \ucde8\ud558\uc5ec\n\uc57c \ud55c\ub2e4.\n  \ub77c. \ubcc0\uce68 \ubc0f \uc120\ud68c\n     1) \uace0\uc18d\ub2e8\uc815\uc758 \uce68\ub85c\ub97c \ubcc0\uacbd\ud558\ub824 \ud560 \ub54c\ub294 \uba3c\uc800 \ubcc0\uce68\ud558\uace0\uc790 \ud558\ub294 \ubc29\ud5a5\uc758 \uc548\uc804\uc744 \ud655\n\uc778\ud558\uace0 \ubcc0\uce68 \uc608\uc815 \uc9c0\uc810\uc5d0 \ub3c4\ub2ec\ud558\uae30 \uc804\uc5d0 \uc801\uc808\ud55c \uc18d\ub825\uc73c\ub85c \ubcc0\uce68\ud55c\ub2e4.\n     2) \uace0\uc18d \ud56d\ud574 \uc911\uc5d0 \ud0c0\ub97c \uae09\uaca9\ud558\uac8c \uc0ac\uc6a9\ud558\uba74 \uace0\uc18d\ub2e8\uc815\uc774 \uc120\ud68c \uc911 \uacbd\uc0ac\uac00 \ucee4\uc838\uc11c \n\ud0d1\uc2b9\uc790\uac00 \uc218\uba74\uc73c\ub85c \ud295\uaca8 \ub5a8\uc5b4\uc9c8 \uc218 \uc788\uc73c\ubbc0\ub85c \uc8fc\uc758\ud574\uc57c \ud55c\ub2e4.\n     3) \uc18d\ub825\uc774 \ube60\ub974\uba74 \uc548\uc815\ub41c \uc0c1\ud0dc\uc5d0\uc11c \ubcc0\uce68\uc774 \ubd88\uac00\ub2a5\ud558\uae30 \ub54c\ubb38\uc5d0 \uc8fc\uc758\ud574\uc57c \ud55c\ub2e4.\n     4) \uace0\uc18d\ub2e8\uc815\uc774 \ubcc0\uce68 \uc608\uc815 \uc9c0\uc810\uc5d0 \ub3c4\ub2ec\ud558\uba74, \ubcc0\uce68\ubaa9\ud45c \ubc29\ud5a5\uc73c\ub85c \ud578\ub4e4\uc744 \ub3cc\ub824\uc11c \uce68\n\ub85c\ub97c \ubcc0\uacbd\ud55c\ub2e4.\n     5) \ud578\ub4e4\uc744 \ub3cc\ub9ac\ub294 \uc591\uc740 \ud544\uc694 \ucd5c\uc18c\ub7c9\uc73c\ub85c \ub3cc\ub9ac\uace0 \ud544\uc694\uc591\ubcf4\ub2e4 \ub354 \ub3cc\ub9ac\uc9c0 \uc54a\ub3c4\ub85d \ud55c\n\ub2e4.", "type": "Document"}}