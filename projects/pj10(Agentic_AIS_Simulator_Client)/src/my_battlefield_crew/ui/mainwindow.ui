                       <property name="styleSheet">
                        <string notr="true">/* 기본 상태: QLineEdit과 동일한 색상, 테두리, 배경 유지 */
QDoubleSpinBox {
    color: rgb(184, 247, 185);
    background-color: rgb(40, 40, 40);
    border: 1px solid rgb(255, 255, 255);
    border-radius: 5px;
}

/* 포커스 상태: 활성화 테두리 색상 변경 */
QDoubleSpinBox:focus {
    border: 1px solid rgb(184, 247, 185);
}

/* 화살표 버튼(서브 컨트롤) 제거: 너비/높이를 0으로 만들어 일반 텍스트 박스처럼 표현 */
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
    background: transparent;
}

/* (선택 사항) 체크박스 해제 등으로 비활성화되었을 때의 스타일 */
QDoubleSpinBox:disabled {
    color: rgb(100, 100, 100);
    background-color: rgb(30, 30, 30);
    border: 1px solid rgb(70, 70, 70);
}</string>
