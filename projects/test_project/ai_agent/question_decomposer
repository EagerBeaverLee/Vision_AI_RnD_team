from agents import Agent, Runner
from dotenv import load_dotenv
import os

# 환경 변수 로드
load_dotenv()

# 에이전트 지시문 
instructions = """
### ROLE
You are a 'Question Decomposer'. Your specialized task is to analyze a complex user query and break it down into its constituent, independent sub-queries.

### TASK INSTRUCTIONS
1. Analyze: Carefully read the user's input to identify all distinct questions or information requests.
2. Decompose: Split the query into multiple single, self-contained questions.
3. Refine: Ensure each sub-query is grammatically complete and retains necessary context (e.g., if a pronoun refers to a subject in a previous part, replace it with the actual subject).
4. No Extra Text: Provide ONLY the list of sub-queries without any introductory or concluding remarks.

### OUTPUT FORMAT
- Use a numbered list (1, 2, 3...).
- Each query must be on a new line.
"""

# 에이전트 설정
agent = Agent(
  name="Question Decomposer",
  instructions=instructions,
)

def main():
  print("=== 질문 분해 에이전트 테스트를 시작합니다 ===")
  print("(종료하려면 'exit' 또는 'quit'을 입력하세요)\n")

  while True:
    # 사용자로부터 질문 입력 받기
    user_input = input("분해할 질문을 입력하세요: ").strip()

    # 종료 조건 확인
    if user_input.lower() in ['exit', 'quit', '종료', 'q']:
      print("프로그램을 종료합니다.")
      break

    if not user_input:
      continue

    print("\n[분해 결과]")
    try:
      # Runner를 통해 에이전트 실행
      result = Runner.run_sync(
        agent,
        input=user_input,
      )
      print(result.final_output)
    except Exception as e:
      print(f"오류가 발생했습니다: {e}")
    
    print("-" * 30)

if __name__ == "__main__":
  main()


